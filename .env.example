# CITYSYNC Environment Configuration
APP_NAME=CITYSYNC
APP_ENV=development
SECRET_KEY=citysync-super-secret-jwt-key-for-hackathon-2026-secure
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (Defaults to SQLite; easily switchable to PostgreSQL)
DATABASE_URL=sqlite:///./citysync.db
# DATABASE_URL=postgresql://postgres:password@localhost:5432/citysync_db

# Simulation Settings
SIMULATION_INTERVAL_SECONDS=5
SIMULATION_AUTO_START=true

# Server Settings
HOST=127.0.0.1
PORT=8000
DEBUG=True
CORS_ORIGINS=["*"]
